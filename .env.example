# SurgProof environment configuration
# Copy to .env and fill in your Gemini API key:
#   cp .env.example .env

GEMINI_API_KEY=your_gemini_api_key_here
FLASH_MODEL=gemini-3.8-flash
ARGON_MODEL=gemini-4-argon

# Optional server & path overrides (defaults resolve relative to repo root)
SURGPROOF_PORT=8600
SURGPROOF_RAW_DIR=raw
SURGPROOF_OUT_DIR=out
# SURGPROOF_CHOLEC_DIR=raw/CholecSeg8k
# SURGPROOF_NARRATOR_DIR=out/narrator
